# Copy to .env and fill in. docker compose reads .env automatically.

# Status page name shown to visitors.
STATUSNOOK_NAME=Statusnook

# Admin account created (and kept in sync) on every start.
STATUSNOOK_ADMIN_USERNAME=admin
STATUSNOOK_ADMIN_PASSWORD=change-me-at-least-8-chars

# Private repository holding the monitors/services/notifications config.
STATUSNOOK_GITHUB_REPO=your-org/your-statusnook-config
STATUSNOOK_GITHUB_CONFIG_PATH=statusnook.yaml
# Leave empty to follow the repository's default branch.
STATUSNOOK_GITHUB_BRANCH=
# Fine-grained personal access token, read-only "Contents" on that repository.
STATUSNOOK_GITHUB_TOKEN=github_pat_...
STATUSNOOK_GITHUB_POLL_INTERVAL=60s

# Optional: public hostname for notification links, and TLS handling.
STATUSNOOK_DOMAIN=
STATUSNOOK_TLS=off
STATUSNOOK_TRUST_PROXY=false
